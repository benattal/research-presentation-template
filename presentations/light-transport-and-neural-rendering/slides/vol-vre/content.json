  "subtitle": "Light in a medium has the same fixed-point form as between surfaces",
  "lines": [
    {
      "tex": "L = \\htmlClass{term-medium}{T(d)}\\, L(d) \\;+",
      "label": "surface behind the medium"
    },
    {
      "tex": "\\hphantom{L =}\\; \\htmlClass{term-medium}{D^{-1}}\\htmlClass{term-emission}{Q} \\;+",
      "label": "emission"
    },
    {
      "tex": "\\hphantom{L =}\\; \\htmlClass{term-medium}{D^{-1}}\\htmlClass{term-bounce-2}{K}\\, L",
      "label": "in-scattering"
    },
    {
      "tex": "x = \\htmlClass{term-emission}{b} + \\htmlClass{term-bounce-2}{A}\\, x",
      "label": "$x = L$, $b = D^{-1}Q + T(d)\\,L(d)$"
    },
    {
      "tex": "\\htmlClass{term-bounce-2}{A} = \\underbrace{\\htmlClass{term-medium}{D^{-1}}}_{\\text{propagation}}\\, \\underbrace{\\htmlClass{term-bounce-2}{K}}_{\\text{scattering}}",
      "label": "one bounce"
    },
    {
      "tex": "x = \\htmlClass{term-emission}{b} + \\htmlClass{term-bounce-1}{Ab} + \\htmlClass{term-bounce-2}{A^2 b} + \\htmlClass{term-bounce-3}{A^3 b} + \\cdots",
      "label": "orders of scattering"
    }
  ],
