{
  "layout": "integratingFactor",
  "sectionLabel": "Volume rendering",
  "title": "Integrating factor",
  "subtitle": "Along one ray, the transfer equation is solved by an integral",
  "buildSteps": [
    {
      "label": "Along one ray, $DL = KL + Q$",
      "equation": "$$-\\frac{dL}{dt} + \\sigma_t L = \\underbrace{KL}_{\\text{in-scattering}} + \\underbrace{Q}_{\\text{emission}}$$"
    },
    {
      "label": "Multiply by $T(t) = e^{-\\int_0^t \\sigma_t\\,ds}$, with $T' = -\\sigma_t T$",
      "equation": "$$\\frac{d}{dt}\\big(T L\\big) = -T\\,(KL + Q)$$"
    },
    {
      "label": "Integrate from $0$ to $d$",
      "equation": "$$L(0) = \\int_0^d T\\,(KL + Q)\\,dt + T(d)\\,L(d)$$"
    },
    {
      "label": "So $D^{-1}$ is an integral along rays",
      "equation": "$$D^{-1}(KL + Q) = \\int_0^d T\\,(KL + Q)\\,dt$$"
    }
  ]
}
