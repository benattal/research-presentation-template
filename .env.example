# Live mode (npm run serve, npm start). Copy to .env and fill in.
# .env is ignored by git; never commit the password.

# Required: the password the presenter window asks for.
PRESENTER_PASSWORD=

# Listening port of the live gateway.
PORT=3000

# Close voting on every poll (results stay visible).
VOTING_DISABLED=false

# Every non-presenter browser follows the presenter's slide.
PRESENTER_CONTROLLED=false

# Where poll votes are saved between restarts.
LIVE_STATE_DIR=.live-state
