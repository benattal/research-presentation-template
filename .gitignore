# Dependencies
node_modules/

# Builds and generated data
/dist/
/data/captures/
/data/recordings/

# Screenshots the user sends as feedback, and who is listening for them
/data/feedback/

# Live server state (poll votes)
/.live-state/

# Environment and secrets: PRESENTER_PASSWORD lives in .env. Never commit.
.env
.env.*
!.env.example

# Presentation assets: their durable copy is the R2 bucket (DATA.md).
/presentations/*/public/
/presentations/*/assets/

# Python caches (media scripts, narration tools)
__pycache__/
*.pyc

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Logs
*.log

# Local tool state; .claude/skills/ is shared agent tooling.
.claude/*
!.claude/skills/
.gradio/

# Python bytecode (narration/)

# The tutorial deck: the picture a reader adds to it is theirs
/tutorial/public/
/tutorial/assets/
